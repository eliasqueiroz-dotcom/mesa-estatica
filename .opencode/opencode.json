{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@github/github-mcp-server"],
      "enabled": true,
      "env": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "supabase-postgrest": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-postgrest@latest", "--apiUrl", "{env:VITE_SUPABASE_URL}/rest/v1", "--apiKey", "{env:VITE_SUPABASE_ANON_KEY}", "--schema", "public"],
      "enabled": true
    }
  }
}
